# Bulk research data: released via Zenodo, never committed (see docs/dataset.md)
data/**
!data/.gitkeep
!data/README.md

# Generated artefacts
*.stl
*.step
*.stp
*.mp4
*.gif
out/

# ...except the committed example parts. These are small, and having them in the
# repo means the team can print the coupons without running Python first.
!examples/coupons/*.stl
!examples/mechanisms/*.stl
!examples/demo_pair/*.stl
!examples/markers/*.png
build/
dist/
*.egg-info/

# uv.lock IS committed: the pinned environment is part of reproducibility.

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
